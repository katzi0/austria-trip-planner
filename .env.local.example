# Map tiles: defaults to free OpenFreeMap (https://openfreemap.org) — no key needed.
# Override with any MapLibre-compatible style URL (e.g. Stadia, Maptiler, self-hosted PMTiles).
NEXT_PUBLIC_MAP_STYLE_URL=

# Vercel Postgres — run `vercel env pull .env.local` after linking Storage → Postgres
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Edit gate (server-only) — anyone who knows this can save changes
EDIT_PASSPHRASE=change-me
